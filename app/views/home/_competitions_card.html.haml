- if competitions.none?
  .card
    .card-body.text-center.text-muted
      Keine Wettkämpfe gefunden.
      - if filter.active?
        = link_to('Filter zurücksetzen', url_for(filter.to_params.slice(:sort)))
- elsif filter.sort_published?
  .card
    .card-header.mt-0
      %h4.mb-0 Neu veröffentlicht
    .list-group.list-group-flush
      - competitions.reorder(Competition.arel_table[:published_at].desc.nulls_last, :date, :name).includes(:disciplines).to_a.each do |competition|
        = render('competition_list_item', competition:, show_published_at: true)
- else
  - grouped_competitions = competitions.reorder(:date, :name, :slug).includes(:disciplines).group_by(&:year_and_month)
  .card
    - grouped_competitions.each_value do |competitions|
      - sample = competitions.first
      .card-header{ class: competitions == grouped_competitions.values.first ? 'mt-0' : 'mt-4' }
        %h4.mb-0
          #{l(sample.date, format: '%B')} #{sample.date.year}

      .list-group.list-group-flush
        - competitions.each do |competition|
          = render('competition_list_item', competition:, show_published_at: false)
